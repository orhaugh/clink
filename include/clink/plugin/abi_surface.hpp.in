// This file is auto-generated by CMake at configure time. Do not edit by
// hand. It bakes the per-header manifest of the declared plugin-ABI surface
// (scripts/plugin-abi-surface.txt) into both the clink binaries and any
// plugin built against this installed header, so that a fingerprint refusal
// can NAME the headers that differ instead of only reporting two opaque
// hashes. Kept separate from abi_version.hpp to keep that header readable:
// this one is a single large constant.

#pragma once

namespace clink::plugin {

// One "path=sha256" line per declared-surface header, in manifest order,
// newline-terminated. The fingerprint is a hash over exactly these entries
// plus the ABI-relevant build options; equal manifests with unequal
// fingerprints therefore point at an options/toolchain difference rather
// than a header edit.
inline constexpr const char* kAbiSurfaceManifest =
    R"clinkabi(@CLINK_ABI_SURFACE_MANIFEST@)clinkabi";

}  // namespace clink::plugin
