// This file is auto-generated by CMake at configure time. Do not edit
// by hand. It bakes the plugin-ABI compatibility values into both the
// clink binaries and any plugin built against this installed header.

#pragma once

// Forces the standard library's configuration macros (__GLIBCXX__,
// _LIBCPP_VERSION, _GLIBCXX_USE_CXX11_ABI) to be visible below regardless of
// what the including TU pulled in first - without this, kToolchain could
// compose differently across TUs of the same build.
#include <cstddef>

#if defined(__has_feature)
#define CLINK_ABI_HAS_FEATURE(x) __has_feature(x)
#else
#define CLINK_ABI_HAS_FEATURE(x) 0
#endif

// Standard-library identity. The value of __GLIBCXX__ / _LIBCPP_VERSION is
// deliberately NOT included: both libraries keep a stable ABI across releases,
// so folding a version number in would rotate the gate on every toolchain
// bump with no layout change behind it. What must match is which library it
// is, and for libstdc++ the dual-ABI choice.
#if defined(_LIBCPP_VERSION)
#define CLINK_ABI_TOOLCHAIN_STDLIB "libc++"
#elif defined(__GLIBCXX__)
#if defined(_GLIBCXX_USE_CXX11_ABI) && _GLIBCXX_USE_CXX11_ABI == 0
#define CLINK_ABI_TOOLCHAIN_STDLIB "libstdc++-cxx11abi0"
#else
#define CLINK_ABI_TOOLCHAIN_STDLIB "libstdc++-cxx11abi1"
#endif
#else
#define CLINK_ABI_TOOLCHAIN_STDLIB "unknown-stdlib"
#endif

// _GLIBCXX_DEBUG swaps container layouts wholesale.
#if defined(_GLIBCXX_DEBUG)
#define CLINK_ABI_TOOLCHAIN_DEBUG ";glibcxx-debug"
#else
#define CLINK_ABI_TOOLCHAIN_DEBUG ""
#endif

// Sanitizers that require every module in the process to be instrumented
// (interceptors, shadow memory, container annotations). UBSan is deliberately
// absent: it neither changes layout nor requires whole-process instrumentation.
#if defined(__SANITIZE_ADDRESS__) || CLINK_ABI_HAS_FEATURE(address_sanitizer)
#define CLINK_ABI_TOOLCHAIN_ASAN ";asan"
#else
#define CLINK_ABI_TOOLCHAIN_ASAN ""
#endif
#if defined(__SANITIZE_THREAD__) || CLINK_ABI_HAS_FEATURE(thread_sanitizer)
#define CLINK_ABI_TOOLCHAIN_TSAN ";tsan"
#else
#define CLINK_ABI_TOOLCHAIN_TSAN ""
#endif
#if CLINK_ABI_HAS_FEATURE(memory_sanitizer)
#define CLINK_ABI_TOOLCHAIN_MSAN ";msan"
#else
#define CLINK_ABI_TOOLCHAIN_MSAN ""
#endif

namespace clink::plugin {

// Toolchain identity: the layout-affecting facts of the COMPILING translation
// unit that the build system cannot hash into the fingerprint (they are
// decided by the compiler environment, not by CMake options). Composed by the
// preprocessor, so a plugin TU bakes the plugin's toolchain and a cluster TU
// bakes the cluster's. The loader refuses a plugin whose toolchain string
// differs from the cluster's - e.g. a TSan cluster and an uninstrumented
// plugin, or a libc++ host and a libstdc++ module. Plugins that predate the
// clink_plugin_toolchain symbol skip this check: they are already refused by
// the fingerprint gate, which rotated when this constant was introduced.
inline constexpr const char* kToolchain =
    CLINK_ABI_TOOLCHAIN_STDLIB CLINK_ABI_TOOLCHAIN_DEBUG CLINK_ABI_TOOLCHAIN_ASAN
        CLINK_ABI_TOOLCHAIN_TSAN CLINK_ABI_TOOLCHAIN_MSAN;

// Structural ABI fingerprint - the DEFAULT load gate. A hash of the DECLARED
// extension surface (the headers named by scripts/plugin-abi-surface.txt: the
// transitive include closure of the plugin authoring entry points) + the
// ABI-relevant build options that surface uses + the pinned Arrow version +
// kAbiVersion, computed at clink configure time (CMakeLists.txt) and baked in
// identically to the cluster and to any plugin built against these headers.
// The loader accepts a plugin whose kAbiFingerprint equals the cluster's and
// refuses otherwise. It rotates when the surface a plugin can reach across the
// dlopen boundary actually changes, but NOT on host-side header edits (sql/,
// embed/, ...) or .cpp / test / doc / build-only commits - so a cluster
// rebuild keeps loading existing plugins unless the contract genuinely moved.
inline constexpr const char* kAbiFingerprint = "@CLINK_ABI_FINGERPRINT@";

// Manual ABI-break knob, folded INTO kAbiFingerprint. Bump it (CLINK_ABI_VERSION
// in CMakeLists.txt) to force-rotate the fingerprint for a semantic break the
// header text does not capture. Also exported for human-readable diagnostics.
inline constexpr int kAbiVersion = @CLINK_ABI_VERSION@;

// Exact commit hash of the clink source tree at build time. INFORMATIONAL:
// reported in logs / plugin metadata for diagnostics, and used as the gate only
// under the opt-in strict mode (CLINK_STRICT_PLUGIN_ABI=1), which restores the
// historic exact-match behaviour. Plugins link against the same clink package
// as the cluster they target, so the value baked into the plugin matches the
// cluster's.
inline constexpr const char* kAbiHash = "@CLINK_ABI_HASH@";

// Source tree was clean (true) or had uncommitted changes (false) at
// build time. Reported for reproducibility diagnostics.
inline constexpr bool kAbiHashIsClean = @CLINK_ABI_HASH_CLEAN@;

// Marketing (semver) version of clink at build time. Informational - the load
// gate uses kAbiVersion, not this. Reported in error messages.
inline constexpr const char* kClinkVersion = "@clink_VERSION@";

}  // namespace clink::plugin
