# tools.env - the pinned TLA+ toolchain for formal/. Sourced by
# scripts/formal-check.sh. POSIX-sh syntax (no bashisms).
#
# The jars are fetched from the upstream GitHub releases and refused unless
# their SHA-256 matches the pin below, so the model checker that gates CI is
# the one that was reviewed. Bump the version and the checksum together.

# TLA+ tools (SANY parser + TLC model checker). Release v1.7.4, TLC 2.19.
TLA_TOOLS_VERSION=1.7.4
TLA_TOOLS_URL=https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar
TLA_TOOLS_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88

# TLA+ CommunityModules with dependencies: the Json module the trace
# validator reads recorded protocol traces with (increment 4 of design
# record 012). Pinned now so the two jars are always fetched as one set.
COMMUNITY_MODULES_VERSION=202607311834
COMMUNITY_MODULES_URL=https://github.com/tlaplus/CommunityModules/releases/download/202607311834/CommunityModules-deps-202607311834.jar
COMMUNITY_MODULES_SHA256=6703730d475c60741624e4dbcfaa9456477a53c970c7c100b531682d0c1a0f8f

# Where the verified jars live. Host default = beside the C++ toolchain prefix
# (gitignored, outside the repo); CI points it at a cached directory.
: "${CLINK_FORMAL_TOOLS_DIR:=${CLINK_DEPS_PREFIX:-${HOME}/.clink-deps}/formal-tools}"
