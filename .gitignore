coverage-report/
*.gcda
*.gcno
*.gcov
*.info
*.profraw
*.profdata

# Sanitizer / debug artefacts (core dump files at repo root).
# Anchored to / so it doesn't match include/clink/core/ etc.
/core
core.*

# Package managers
vcpkg_installed/

# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~

# Logs
*.log

# Linux build of example plugin .so dropped here by the cluster
# demo flow (built via clink-build:latest, not host toolchain).
canonical_pipeline_job.so
build-linux-jobs/

# In-proc bench artifacts: results logs and Maven shade output.
benchmarks/inproc_compare/results/
benchmarks/inproc_compare/flink-job/target/

# Prod-feature bench suite: per-bench results dirs and Maven targets.
benchmarks/prod_compare/*/results/
benchmarks/prod_compare/*/flink-job/target/
# A stray local-path interpretation of the rocksdb:// URI can drop a
# rocksdb:/ dir next to the bench when a child process cwd's locally.
benchmarks/prod_compare/*/rocksdb:/

# Internal work-tracking docs live locally only; never under version control.
# (the buildable consumer-examples and the published connector docs stay tracked,
# as do the docs-site pages: landing, capabilities, design decisions)
/docs/*
!/docs/consumer-examples/
!/docs/guides/
!/docs/tutorials/
!/docs/connectors/
!/docs/internals/
!/docs/design/
!/docs/qualification/
!/docs/index.md
!/docs/capabilities.md
!/docs/compatibility.md
!/docs/benchmarks.md
!/docs/efficiency.md
!/docs/sql.md
# Historical records (closed audits and their work trackers). Tracked
# deliberately: they are the audit trail for the hardening work, which
# belongs in the repository rather than in someone's local notes. NOT added
# to mkdocs' exclude_docs allowlist, so they are reviewable in git without
# being published as user-facing site pages.
!/docs/history/
!/docs/assets/

# MkDocs build output
/site/

# Python package artifacts (pyclink)
__pycache__/
*.egg-info/
python/dist/
python/build/

# Split cloud rig results (raw per-run JSON; the summary lives in cloud/README.md)
benchmarks/nexmark_compare/cloud/results-split*/

# ---------------------------------------------------------------------------
# Fuzz corpus.
#
# Three kinds of file live under fuzz/corpus/<target>/ and only two are
# tracked, on purpose.
#
#   seed-*        GENERATED at build time by clink_fuzz_seeds, from the real
#                 encoders. Not tracked: a committed seed goes stale the
#                 first time a message gains a field, and a stale seed
#                 narrows what the fuzzer explores without anyone noticing.
#                 Regenerating is a build target.
#
#   crash-*       REPRODUCERS. Tracked, always. Their whole value is being
#   leak-*        the exact bytes that broke something, so
#   timeout-*     tests/test_fuzz_corpus.cpp replays them forever on builds
#   oom-*         that cannot run a fuzzer at all. This is what makes a
#                 fuzzer finding into a permanent regression test.
#
#   <hex hash>    Coverage inputs libFuzzer discovered. NOT tracked: a
#                 minimised cluster_frame corpus alone is 308 files and
#                 1.2 MB of blobs nobody can review, and the marginal
#                 coverage over the deterministic property tests in
#                 tests/test_frame_robustness.cpp is modest. Keep them
#                 locally - they make your next run start warm - and let a
#                 long campaign publish a corpus out of tree.
/fuzz/corpus/*/*
!/fuzz/corpus/*/.gitkeep
!/fuzz/corpus/*/crash-*
!/fuzz/corpus/*/leak-*
!/fuzz/corpus/*/timeout-*
!/fuzz/corpus/*/oom-*
qualification-results/

# TLC writes its state files beside the model when run by hand (the script uses a temp -metadir)
/formal/**/states/
