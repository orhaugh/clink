## clink runtime image - builds clink_node from source against the
## pinned build toolchain and ships it ready to run as coordinator or worker.
##
## Prereq: clink-build:latest must exist locally. Build it once with:
##   docker build -t clink-build:latest -f docker/Dockerfile .
##
## After that, docker-compose.yml (at the repo root) builds this image
## and spins up a 1 coordinator + 3 worker cluster.
##
## BASE_IMAGE exists so CI can build against the pinned toolchain image it
## already published to GHCR instead of a local tag that only exists on a
## developer's machine:
##   docker build --build-arg BASE_IMAGE=ghcr.io/<owner>/clink-build:main \
##     -t clink-runtime:latest -f docker/Dockerfile.runtime .
## The default keeps the local workflow above unchanged.
ARG BASE_IMAGE=clink-build:latest
FROM ${BASE_IMAGE}

USER root
WORKDIR /src
COPY . /src
# Build clink_node + the unified `clink` client CLI. Release mode
# for a reasonable runtime footprint; the build image already has
# every dependency installed so no extra apt-get steps are needed.
# RocksDB (bundled at the pinned tag in impls/rocksdb/CMakeLists.txt)
# is fetched and compiled during this step - first build adds ~5-8
# min, subsequent rebuilds reuse the Docker layer cache.
#
# CMAKE_BUILD_PARALLEL_LEVEL caps job-count so the container doesn't
# spawn one compile per host core. Docker Desktop on Mac caps the
# container's nproc anyway, but being explicit here keeps the build
# polite on hosts that haven't tuned Docker's resource allocation.
# An ARG rather than a fixed 4 so a dedicated build host can use the
# cores it has: the default left an 8-core qualification builder running
# at a load of 1.4.
ARG BUILD_PARALLEL=4
ENV CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_PARALLEL}
# Opt-in: bake the ForSt state backend into the runtime (forst:// and the
# forst_s3 schemes). Default OFF keeps the image build identical; ON adds
# the ForSt engine's ExternalProject fetch + build (~5-8 min, needs
# network). Usage: docker build --build-arg CLINK_WITH_FORST=ON ...
ARG CLINK_WITH_FORST=OFF
# Opt-in: link jemalloc as the process allocator. Default OFF on the measured
# evidence - against the SAME clink binary with only the allocator changed, it
# gave +5% sustained throughput on the windowed nexmark query, neutral on the
# stateless one, neutral CPU per event, and no memory change
# (benchmarks/nexmark_compare/cloud/README.md). Adds one apt package and no
# build time. Usage:
#   docker build --build-arg CLINK_WITH_JEMALLOC=ON -t clink-runtime:jemalloc \
#     -f docker/Dockerfile.runtime .
# `clink_node --version` prints the allocator, so an image can be checked rather
# than assumed.
# ON by default since QUAL-10 (followups item 84). Under repeated recovery
# a worker on glibc malloc reached 3.3 GB and kept it after the job was
# gone, with the per-thread-arena signature (19 mappings of exactly 64 MiB);
# jemalloc with prompt purging held ~1 GB at peak and returned it. Not a
# leak - measured as allocator retention - but a process that grows to
# 3.3 GB and stays there is one that gets OOM-killed on a small node.
# Pass OFF to compare against the system allocator.
ARG CLINK_WITH_JEMALLOC=ON
# Raise the instruction-set baseline for compiled code, e.g. x86-64-v3 (AVX2) or
# x86-64-v4 (AVX-512). Empty = the toolchain default, which on x86-64 is SSE2.
# A PORTABILITY decision: an image built this way will not run on CPUs below the
# chosen level, which is why it is empty by default for a published image.
#   docker build --build-arg CLINK_ISA_BASELINE=x86-64-v3 ...
ARG CLINK_ISA_BASELINE=
# Runtime fault-injection points. OFF for a shipped image: no fault
# surface at all. ON builds a QUALIFICATION image, where the chaos
# controller can crash a process inside a named 2PC window
# (CLINK_FAULT_INJECT) - windows an external kill cannot hit reliably.
# It must be an explicit opt-in rather than following CLINK_BUILD_TESTS,
# because arming CLINK_FAULT_INJECT against a build without the surface
# is a SILENT no-op: the campaign would report faults it never injected.
# `clink --capabilities` reports the resulting state, and the
# qualification campaign asserts it before using the profile.
ARG CLINK_ENABLE_FAULT_INJECTION=OFF

# QUAL-11's schema-evolution job plugins (three .so variants from one
# source). Opt-in like fault injection: a shipped image carries no
# campaign fixtures unless the qualification build asks.
ARG CLINK_BUILD_QUAL11_JOBS=OFF

# The commit this image was built from.
#
# The build normally derives it from .git, which a source archive does
# not carry - so an archive build reported git_sha=unknown and the image
# could not state which revision it was. For a qualification campaign
# that is the whole provenance chain: the results are only attributable
# to a commit if the binary under test can name it.
ARG CLINK_GIT_SHA=
# CLINK_BUILD_SQL=ON so clink_node registers the SQL operator factories
# (json_string_to_row, window_row, equi_join_row, ...) - required to run SQL
# jobs (e.g. the Nexmark queries) against a containerized cluster; without it the
# coordinator planner rejects the spec with "no operator factory registered".
# Release + LTO (interprocedural optimisation) for a maximally-optimised runtime,
# then strip the binaries (perf-neutral, smaller image). Throughput-grade build.
RUN if [ "${CLINK_WITH_JEMALLOC}" != "OFF" ]; then \
        apt-get update -qq && apt-get install -y -qq --no-install-recommends libjemalloc-dev \
        && rm -rf /var/lib/apt/lists/*; \
    fi \
 && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCLINK_BUILD_SQL=ON \
        -DCLINK_BUILD_TESTS=OFF \
        -DCLINK_ENABLE_FAULT_INJECTION=${CLINK_ENABLE_FAULT_INJECTION} \
        -DCLINK_WITH_FORST=${CLINK_WITH_FORST} \
        -DCLINK_WITH_JEMALLOC=${CLINK_WITH_JEMALLOC} \
        -DCLINK_ISA_BASELINE=${CLINK_ISA_BASELINE} \
        -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON \
        -DCLINK_ABI_HASH=${CLINK_GIT_SHA} \
        -DCLINK_BUILD_QUAL11_JOBS=${CLINK_BUILD_QUAL11_JOBS} \
    # Build EVERYTHING (tests off): `cmake --install` below installs every
    # tool the install rules cover, and a selective build leaves some of
    # them missing (clink_submit_sql was the one that failed). The extra
    # cost over the historic selective build is a handful of thin CLI
    # binaries over the already-compiled core.
    && cmake --build build \
    && cp build/clink_node /usr/local/bin/clink_node \
    && cp build/clink     /usr/local/bin/clink \
    && cp build/clink_submit_job /usr/local/bin/clink_submit_job \
    && strip /usr/local/bin/clink_node /usr/local/bin/clink /usr/local/bin/clink_submit_job \
    && mkdir -p /opt/clink/jobs \
    # The runnable example ships INSIDE the image so trying clink is one
    # command with nothing to fetch, clone or configure: the SQL and the
    # data it reads sit next to each other under /opt/clink/examples, and
    # WORKDIR below makes the relative path in the script resolve.
    && mkdir -p /opt/clink/examples \
    && cp -r examples/sql /opt/clink/examples/ \
    # In the repo the script reads its data by a repo-relative path so
    # `clink run examples/sql/hello.sql` works from a checkout. In the image
    # there is no checkout and no fixed working directory, so the shipped
    # copy points at itself absolutely.
    && sed -i "s#'examples/sql/events.ndjson'#'/opt/clink/examples/sql/events.ndjson'#" \
        /opt/clink/examples/sql/hello.sql \
    && cp docker/entrypoint.sh /usr/local/bin/clink-entrypoint \
    && chmod +x /usr/local/bin/clink-entrypoint \
    && cp build/examples/k8s_smoke_job.so /opt/clink/jobs/k8s_smoke_job.so \
    && cp build/examples/rescale_test_job.so /opt/clink/jobs/rescale_test_job.so \
    # QUAL-11's schema-evolution trio, when the qualification build asked
    # for them. They MUST be built here rather than shipped in: the plugin
    # ABI fingerprint is the engine's git SHA, so a .so built anywhere else
    # is rejected at submit by the gate that exists to catch exactly that.
 && if [ "${CLINK_BUILD_QUAL11_JOBS}" = "ON" ]; then \
        cp build/qualification/qual11/qual11_job_v1.so \
           build/qualification/qual11/qual11_job_v2.so \
           build/qualification/qual11/qual11_job_v2_broken.so /opt/clink/jobs/; \
    fi \
    # Install the SDK (headers, static libs, CMake package) into /usr/local
    # before dropping the build tree: a job plugin must be compiled on the
    # WORKERS' platform against the SAME clink commit (the ABI gate compares
    # git SHAs), and this image is the one place both are guaranteed. With
    # the SDK baked in, `docker run --entrypoint cmake` against a mounted
    # consumer checkout builds a submittable .so in seconds - no second
    # toolchain image, no in-container engine rebuild.
    && cmake --install build > /dev/null \
    && rm -rf build

WORKDIR /var/lib/clink

# Demo run knobs for the bundled rescale-test streaming job: a large record
# count + a 100ms tick make it run effectively forever (a long-lived, gently
# active streaming job), so a cluster shows a running job with busy slots and
# ticking checkpoints. Read by the job's define_job on whichever node loads the
# .so (coordinator at submit + workers at deploy), hence set image-wide. Override per-service
# in compose to change the rate. (CLINK_RESCALE_OUT_BASE defaults to /tmp.)
ENV CLINK_RESCALE_COUNT=1000000000 \
    CLINK_RESCALE_TICK_MS=100 \
    CLINK_RESCALE_INITIAL_P=6

# 6123: coordinator control plane (workers connect here)
# 8081: coordinator dashboard + HTTP API (also worker HTTP API when set)
# 6124+: data plane ports - left implicit (auto-bound), reachable via
# the compose-internal network so no explicit EXPOSE needed.
# Allocator policy for the shipped image (item 84). Both halves matter and
# were measured separately: fixing one layer leaves the other's retention
# in place.
#
#   MALLOC_CONF: jemalloc returns freed pages to the OS promptly instead of
#   holding them as dirty; without a background thread the purge only runs
#   on allocation activity, which an idle-after-failover worker has none of.
#
#   ARROW_DEFAULT_MEMORY_POOL: libarrow carries a BUNDLED jemalloc for its
#   default pool, governed by neither the process allocator nor MALLOC_CONF.
#   Routing it to the system allocator puts every allocation in the process
#   under one policy. Arrow reads this at startup.
#
# Operators can override either at deploy; they are environment, not code.
ENV MALLOC_CONF=background_thread:true,dirty_decay_ms:5000,muzzy_decay_ms:0 \
    ARROW_DEFAULT_MEMORY_POOL=system

EXPOSE 6123 8081

ENTRYPOINT ["/usr/local/bin/clink-entrypoint"]
