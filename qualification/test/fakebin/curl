#!/usr/bin/env bash
# Fake curl for the coordinator API and metrics.
set -uo pipefail
. "$FAKERIG/../rigsim.sh"
url=""; for a in "$@"; do case "$a" in http*) url="$a";; esac; done
case "$url" in
  */metrics)
      [ "$(rig_scenario metrics_unreachable 0)" = "1" ] && exit 7
      echo "clink_coordinator_workers_lost_total $(rig_scenario workers_lost 1)"
      echo "clink_coordinator_job_restarts_total 1"
      ;;
  */api/v1/jobs/*/cancel) echo '{"ok":true}';;
  */api/v1/jobs)
      # The exactly-one-job gate: the sim's healthy rig has one job; a
      # scenario can inject a zombie twin to drive the gate's refusal.
      if [ "$(rig_scenario extra_job 0)" = "1" ]; then
        echo '{"jobs":[{"id":1,"status":"RUNNING"},{"id":2,"status":"RUNNING"}]}'
      else
        echo '{"jobs":[{"id":1,"status":"RUNNING"}]}'
      fi
      ;;
  */api/v1/jobs/*)
      st=$(rig_scenario job_status RUNNING)
      n=$(rig_bump jobpoll)
      dies=$(rig_scenario job_dies_after 0)
      [ "$dies" != "0" ] && [ "$n" -gt "$dies" ] && st=FAILED
      # A coordinator that answers nothing for a window of status polls:
      # the shape a legitimate armed-fault recovery presents to the
      # campaign's job-gone probe. from/until are 1-based poll ordinals.
      gone_from=$(rig_scenario job_gone_from_poll 0)
      gone_until=$(rig_scenario job_gone_until_poll 0)
      if [ "$gone_from" != "0" ] && [ "$n" -ge "$gone_from" ] && [ "$n" -le "$gone_until" ]; then
        exit 22
      fi
      [ "$st" = "GONE" ] && exit 22
      echo "{\"id\":1,\"status\":\"$st\",\"latest_completed_checkpoint_id\":42,\"checkpoints_completed\":42,\"tasks\":[1],\"errors\":[]}"
      ;;
  */api/v1/connectors) echo '{"connectors":[{"name":"kafka","available":true}]}';;
  *) echo '{}';;
esac
exit 0
