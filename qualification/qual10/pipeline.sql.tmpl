-- QUAL-09 pipeline: Kafka -> TTL'd DISTINCT -> TTL'd unwindowed GROUP BY
-- -> Postgres upsert table. The QUAL-05 retention shape, reused once more.
--
-- What is under test is the INFRASTRUCTURE underneath the job - a state
-- volume at capacity, partitions sustained past every recovery deadline,
-- stepped host clocks - so the workload's job is to be the programme's
-- best-understood subject: exactly verifiable per key from the
-- generator's seed, with live keyed state for the faults to threaten.
-- Retention is declared (bounded state is table stakes since QUAL-05)
-- but not gated on; QUAL-05 owns that claim.
--
-- __BROKERS__, __CONNINFO__, __WM_LAG_MS__, __GROUP__ and __STATE_TTL_MS__
-- are substituted by the campaign driver.
CREATE TABLE q10_in (event_id TEXT, k BIGINT, amount BIGINT, ts BIGINT)
  WITH (connector='kafka', format='json', brokers='__BROKERS__',
        topic='qual10-in', group_id='__GROUP__',
        auto_offset_reset='earliest',
        event_time_column='ts', watermark_lag_ms='__WM_LAG_MS__',
        state_ttl='__STATE_TTL_MS__', state_ttl_domain='event_time');

CREATE TABLE q10_out (k BIGINT, n BIGINT)
  WITH (connector='postgres',
        conninfo='__CONNINFO__',
        "table"='public.q10_out',
        mode='upsert',
        primary_key='k');

-- COUNT(*) aliased to its target column: the JSON-family SQL sinks
-- resolve columns BY NAME and an unaliased expression plans as _col1,
-- which writes NULL into n for every row, silently. Found on QUAL-04.
INSERT INTO q10_out
SELECT k, COUNT(*) AS n
FROM (SELECT DISTINCT event_id, k FROM q10_in) d
GROUP BY k;
