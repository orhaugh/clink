# The ops console clink ships: clink-fe's release asset
# clink-console-v<version>.tar.gz, which scripts/fetch-console.sh installs at
# <prefix>/share/clink/console in the SDK tarball and the runtime image once it
# matches the sha256 below. Kept apart from versions.env, whose hash keys the
# toolchain image and the dependency caches, so a console bump rebuilds
# neither. To bump: tag clink-fe, check the bundle its release publishes
# against the .sha256 beside it, and set both lines.
CLINK_CONSOLE_VERSION=0.2.0
CLINK_CONSOLE_SHA256=9f2f07aea7c56edb80e2aa497d0f14ef2d2780ae79160bc75026895296f8cb93
