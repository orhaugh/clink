#!/usr/bin/env bash
set -euo pipefail

# Run clang-format check via the CMake format-check target. Exits
# non-zero if any source file violates formatting.

BUILD_DIR="cmake-build-debug"

if [ ! -d "$BUILD_DIR" ]; then
    echo "pre-commit: build directory '$BUILD_DIR' not found, skipping format check"
    exit 0
fi

echo "pre-commit: checking fault points have call sites..."
if ! ./scripts/check-fault-points.sh; then
    echo ""
    echo "pre-commit: a declared fault point has no call site. See the message above."
    exit 1
fi

echo "pre-commit: checking nested test timeouts..."
if ! ./scripts/check-nested-timeouts.py; then
    echo ""
    echo "pre-commit: a test waits on a child for less than the child's own timeout, so the"
    echo "child's reason for failing can never be printed. See the message above."
    exit 1
fi

echo "pre-commit: checking for new sleep-instead-of-a-condition..."
if ! ./scripts/check-bare-sleeps.py; then
    echo ""
    echo "pre-commit: an integration test gained a sleep where it should wait for a"
    echo "condition, or a baseline entry is now stale. See the message above."
    exit 1
fi

echo "pre-commit: checking clang-format..."
if ! cmake --build "$BUILD_DIR" --target format-check 2>&1; then
    echo ""
    echo "pre-commit: formatting violations found."
    echo "Run 'cmake --build $BUILD_DIR --target format' to fix, then re-stage."
    exit 1
fi
