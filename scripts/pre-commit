#!/usr/bin/env bash
set -euo pipefail

# Run clang-format check via the CMake format-check target. Exits
# non-zero if any source file violates formatting.

# Deliberately ABOVE the build-directory guard below: this check needs no
# build, and a status claim that contradicts the published evidence should
# never reach a commit just because someone has no cmake-build-debug.
echo "pre-commit: checking for em dashes in tracked prose..."
if ! ./scripts/check-no-em-dashes.py; then
    echo ""
    echo "pre-commit: an em dash reached tracked prose. Use a spaced hyphen or restructure."
    exit 1
fi

echo "pre-commit: checking page front matter parses..."
if ! ./scripts/check-docs-front-matter.py; then
    echo ""
    echo "pre-commit: a page's YAML front matter does not parse. MkDocs would render it as"
    echo "body text and drop the page's title and meta description. Quote any value"
    echo "containing a colon-space."
    exit 1
fi

echo "pre-commit: checking qualification status against the published pages..."
if ! ./scripts/check-qualification-status.py; then
    echo ""
    echo "pre-commit: qualification-plan.json disagrees with docs/qualification/."
    echo "The published page is authoritative; the plan must follow it."
    exit 1
fi

echo "pre-commit: checking the declared plugin-ABI surface manifest..."
if ! ./scripts/gen-plugin-abi-surface.py --check; then
    echo ""
    echo "pre-commit: scripts/plugin-abi-surface.txt no longer matches the include"
    echo "closure of the plugin authoring surface. Regenerate it with"
    echo "scripts/gen-plugin-abi-surface.py and review the diff - it is a change"
    echo "to the extension compatibility contract."
    exit 1
fi

echo "pre-commit: checking the public API tier manifest..."
if ! ./scripts/gen-public-api-surface.py --check; then
    echo ""
    echo "pre-commit: scripts/public-api-surface.txt no longer matches the header"
    echo "tiers or the Stable include reach. Regenerate it with"
    echo "scripts/gen-public-api-surface.py and review the diff - it is a change"
    echo "to the 1.x compatibility contract (design record 011)."
    exit 1
fi

echo "pre-commit: checking the Stable C ABI symbol manifest..."
if ! ./scripts/check-c-abi-symbols.py; then
    echo ""
    echo "pre-commit: include/clink/embed/clink.h and scripts/libclink-abi-symbols.txt"
    echo "disagree. A new function is appended to the manifest; a removal is a break"
    echo "of the Stable C ABI (design record 011)."
    exit 1
fi

BUILD_DIR="cmake-build-debug"

if [ ! -d "$BUILD_DIR" ]; then
    echo "pre-commit: build directory '$BUILD_DIR' not found, skipping format check"
    exit 0
fi

echo "pre-commit: checking fault points have call sites..."
if ! ./scripts/check-fault-points.sh; then
    echo ""
    echo "pre-commit: a declared fault point has no call site. See the message above."
    exit 1
fi

echo "pre-commit: checking nested test timeouts..."
if ! ./scripts/check-nested-timeouts.py; then
    echo ""
    echo "pre-commit: a test waits on a child for less than the child's own timeout, so the"
    echo "child's reason for failing can never be printed. See the message above."
    exit 1
fi

echo "pre-commit: checking for new sleep-instead-of-a-condition..."
if ! ./scripts/check-bare-sleeps.py; then
    echo ""
    echo "pre-commit: an integration test gained a sleep where it should wait for a"
    echo "condition, or a baseline entry is now stale. See the message above."
    exit 1
fi

echo "pre-commit: checking clang-format..."
if ! cmake --build "$BUILD_DIR" --target format-check 2>&1; then
    echo ""
    echo "pre-commit: formatting violations found."
    echo "Run 'cmake --build $BUILD_DIR --target format' to fix, then re-stage."
    exit 1
fi
